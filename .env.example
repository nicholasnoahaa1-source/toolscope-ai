# Copie este arquivo para .env e preencha com a connection string real do Neon
# (Settings > Connection string no painel do Neon, formato "pooled connection").
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Painel da Vida (opcional). Em deploy, onde não existe o arquivo
# data/life-snapshot.local.json, cole aqui o JSON do snapshot inteiro.
# LIFE_SNAPSHOT_JSON='{"generatedAt":"...","owner":{...},...}'
