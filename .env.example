# Connection string do banco Postgres (Supabase/Neon). No Supabase:
# Project Settings > Database > Connection string (modo "Transaction pooler").
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Chave secreta usada para assinar os cookies de sessão (JWT). Gere uma
# string aleatória longa, por exemplo com: openssl rand -base64 32
SESSION_SECRET="troque-por-uma-chave-secreta-aleatoria"

# Usados para salvar/baixar arquivos (materiais e entregas) no Supabase
# Storage (bucket privado "arquivos"). Em Project Settings > API:
# SUPABASE_URL = "Project URL"
# SUPABASE_SERVICE_ROLE_KEY = chave "service_role" (secreta — nunca exponha
# no cliente; só é usada em código de servidor).
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="troque-pela-chave-service_role-do-projeto"
