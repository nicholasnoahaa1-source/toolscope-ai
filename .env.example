# Copie este arquivo para .env e preencha com a connection string real do Neon
# (Settings > Connection string no painel do Neon, formato "pooled connection").
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Chave secreta usada para assinar os cookies de sessão (JWT). Gere uma
# string aleatória longa, por exemplo com: openssl rand -base64 32
SESSION_SECRET="troque-por-uma-chave-secreta-aleatoria"
