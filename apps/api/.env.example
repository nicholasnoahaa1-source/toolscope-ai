# Copie para .env dentro de apps/api/. Valores fictícios — sem segredos reais.
JARVIS_ENVIRONMENT=development
JARVIS_LOG_LEVEL=INFO
JARVIS_CHAT_PROVIDER=mock

# Origens permitidas para CORS em desenvolvimento (lista separada por vírgula
# quando definida via variável de ambiente real; o default já cobre o Vite).
# JARVIS_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Quando um provedor de IA real for adicionado no futuro, a chave viverá
# aqui — nunca no frontend, nunca commitada com valor real.
# JARVIS_ANTHROPIC_API_KEY=changeme
