// Prisma schema para testes locais com SQLite
// Use este arquivo para dev/test local, então migre para Supabase em produção

datasource db {
  provider = "sqlite"
  url      = "file:./analytics.db"
}

generator client {
  provider = "prisma-client-js"
}

model AnalyticsMetric {
  id        String   @id @default(cuid())
  contentId String
  views     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  saves     Int      @default(0)
  orders    Int      @default(0)
  revenue   Float    @default(0)
  platform  String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId])
  @@index([createdAt])
}

model AnalyticsContentGenerated {
  id        String   @id @default(cuid())
  cascadeId String
  contentType String
  contentData String
  llmModel  String   @default("claude-3-sonnet")
  duration  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cascadeId])
  @@index([createdAt])
}

model AnalyticsContentPublished {
  id        String   @id @default(cuid())
  contentId String
  platform  String
  publishedUrl String?
  publishedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId])
  @@index([platform])
  @@index([createdAt])
}

model AnalyticsSyncLog {
  id        String   @id @default(cuid())
  status    String   @default("pending")
  batchSize Int      @default(0)
  error     String?
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
