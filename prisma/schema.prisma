generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ALUNO
  PROFESSOR
  ADMIN
}

enum StatusEntrega {
  PENDENTE
  ENTREGUE
  ATRASADA
  AVALIADA
}

enum TipoMaterial {
  ARQUIVO
  LINK
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  role          Role          @default(ALUNO)
  createdAt     DateTime      @default(now())

  turmasLecionadas Turma[]      @relation("Professor")
  matriculas       Matricula[]
  atividadesCriadas Atividade[] @relation("AutorAtividade")
  entregas         Entrega[]
  materiaisCriados Material[]   @relation("AutorMaterial")
  avisosCriados    Aviso[]      @relation("AutorAviso")
  arquivosEnviados Arquivo[]

  @@index([email])
}

model Turma {
  id          String   @id @default(cuid())
  nome        String
  descricao   String?
  codigo      String   @unique
  professorId String
  professor   User     @relation("Professor", fields: [professorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  matriculas  Matricula[]
  atividades  Atividade[]
  materiais   Material[]
  avisos      Aviso[]

  @@index([professorId])
}

model Matricula {
  id        String   @id @default(cuid())
  turmaId   String
  alunoId   String
  turma     Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  aluno     User     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([turmaId, alunoId])
  @@index([alunoId])
}

model Atividade {
  id          String    @id @default(cuid())
  turmaId     String
  turma       Turma     @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User      @relation("AutorAtividade", fields: [autorId], references: [id])
  titulo      String
  descricao   String
  prazo       DateTime?
  createdAt   DateTime  @default(now())

  anexos      Arquivo[]  @relation("AnexoAtividade")
  entregas    Entrega[]

  @@index([turmaId])
}

model Entrega {
  id          String        @id @default(cuid())
  atividadeId String
  atividade   Atividade     @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  alunoId     String
  aluno       User          @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  comentario  String?
  status      StatusEntrega @default(PENDENTE)
  nota        Float?
  feedback    String?
  enviadaEm   DateTime?
  avaliadaEm  DateTime?
  createdAt   DateTime      @default(now())

  arquivos    Arquivo[]     @relation("AnexoEntrega")

  @@unique([atividadeId, alunoId])
  @@index([alunoId])
}

model Material {
  id        String       @id @default(cuid())
  turmaId   String
  turma     Turma        @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User         @relation("AutorMaterial", fields: [autorId], references: [id])
  titulo    String
  tipo      TipoMaterial @default(ARQUIVO)
  url       String?
  createdAt DateTime     @default(now())

  arquivos  Arquivo[]    @relation("AnexoMaterial")

  @@index([turmaId])
}

model Aviso {
  id        String   @id @default(cuid())
  turmaId   String
  turma     Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User     @relation("AutorAviso", fields: [autorId], references: [id])
  titulo    String
  conteudo  String
  createdAt DateTime @default(now())

  @@index([turmaId])
}

model Arquivo {
  id           String   @id @default(cuid())
  nomeOriginal String
  caminho      String
  mimeType     String
  tamanho      Int
  enviadoPorId String
  enviadoPor   User     @relation(fields: [enviadoPorId], references: [id])
  createdAt    DateTime @default(now())

  atividadeId  String?
  atividade    Atividade? @relation("AnexoAtividade", fields: [atividadeId], references: [id], onDelete: Cascade)
  entregaId    String?
  entrega      Entrega?   @relation("AnexoEntrega", fields: [entregaId], references: [id], onDelete: Cascade)
  materialId   String?
  material     Material?  @relation("AnexoMaterial", fields: [materialId], references: [id], onDelete: Cascade)

  @@index([atividadeId])
  @@index([entregaId])
  @@index([materialId])
}
